% Hiển thị URL: fill đến hết chiều rộng dòng rồi mới thêm "…".
% Hyperlink luôn trỏ đến URL đầy đủ.
% Thuật toán: thử N từ 60 giảm dần, chọn N lớn nhất
% sao cho <N ký tự sau "//"> + "…" vừa khít ≤ 1 dòng.
\makeatletter
\newcommand{\smarturl}[1]{%
  \begingroup
  % đo URL đầy đủ trước; nếu vừa thì hiển thị nguyên bản
  \settowidth{\@tempdima}{\href{#1}{\color{primarypurple}#1}}%
  \ifdim\@tempdima>\dimexpr\linewidth-2\fboxsep\relax
    \StrBehind{#1}{//}[\@body]%
    \StrLen{\@body}[\@bodylen]%
    % N = min(\@bodylen, 60)
    \ifnum\@bodylen>60
      \StrLeft{\@body}{60}[\@body]%
      \@tempcnta=60\relax
    \else
      \@tempcnta=\@bodylen\relax
    \fi
    % thử từ N xuống 10, chọn N lớn nhất vừa khít
    \loop
      \ifnum\@tempcnta<10
        % fallback: cắt cứng 10 ký tự
        \@tempcnta=10\relax
      \fi
      \StrLeft{\@body}{\the\@tempcnta}[\@try]%
      \settowidth{\@tempdima}{\href{#1}{\color{primarypurple}\@try\dots}}%
      \ifdim\@tempdima>\dimexpr\linewidth-2\fboxsep\relax
        \advance\@tempcnta by -1\relax
      \else
        \href{#1}{\color{primarypurple}\@try\dots}%
        \@tempcnta=0\relax % thoát vòng lặp
      \fi
    \ifnum\@tempcnta>0 \repeat
  \else
    \href{#1}{\color{primarypurple}#1}%
  \fi
  \endgroup
}
\makeatother

% =====================================================================
%  \imagesource{URL} — chèn footnote "nguồn ảnh: <URL>" ở chân trang
%
%  Cách dùng:
%
%    \begin{figure}
%      \includegraphics{...}
%      \caption{Mô tả \protect\imagesource{URL}}
%    \end{figure}
%
%  Hoặc (đặt marker trong caption, footnote ở cuối trang):
%
%    \begin{figure}
%      \includegraphics{...}
%      \caption{Mô tả \protect\imagesourcemark}
%    \end{figure}
%    \imagesource{URL}
%
%  Cơ chế:
%    - \imagesourcemark: in superscript và tăng counter `imagesourcecount`.
%    - \imagesource{URL}: dùng giá trị hiện tại của counter cho footnote.
%
%  2-pass: trong mỗi lần chạy pdflatex, caption được xử lý 2 lần.
%  Nhưng nhờ giá trị counter được lưu vào .aux, lần chạy pdflatex sau
%  sẽ sử dụng giá trị đúng.
% =====================================================================

\makeatletter
\newcounter{imagesourcecount}

% \imagesourcemark: chỉ in superscript với giá trị HIỆN TẠI của counter
% (chưa được tăng bởi \imagesource). Đặt trong \caption.
% Không tăng counter tại đây — counter chỉ tăng khi \imagesource chạy.
%
% LƯU Ý KHI DÙNG TRONG \caption:
%   Vì \listoffigures ghi lại toàn bộ text của \caption, số "1" ở
%   superscript sẽ xuất hiện trong "Danh mục hình vẽ". Để ẩn nó ở
%   danh mục, hãy LUÔN dùng cú pháp \caption[short]{long}:
%
%     \caption[Minh họa XYZ]{Minh họa XYZ\protect\imagesourcemark}
%
%   Trong đó short là caption không có \imagesourcemark, long là
%   caption đầy đủ có \imagesourcemark. Nhờ đó LOF dùng short
%   (không có số "1"), còn hình thật vẫn hiện số "1" như mong muốn.
\protected\def\imagesourcemark{%
  \textsuperscript{\the\numexpr\value{imagesourcecount}+1\relax}%
}

% \imagesource{URL}: tăng counter, in footnote ở chân trang với số
% hiện tại. Đặt sau \end{figure}.
\newcommand{\imagesource}[1]{%
  \stepcounter{imagesourcecount}%
  \footnotetext[\value{imagesourcecount}]{%
    \footnotesize
    \textit{nguồn ảnh:}~\smarturl{#1}%
  }%
}
\makeatother

